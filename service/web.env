# Settings for the web service (read every time the service starts).
# After editing:  sudo systemctl restart new-optimized-web
MODEL=/mnt/raspi-ssd/New/yolo_128_int8_xnnpack.pte   # model file (the 128 x 128 INT8 model)
IMGSZ=128                                            # must match the model: 128 for the 128 model, 256 for the 256 model
STREAM=main                                          # main = camera main stream (1920x1080), sub = sub stream (704x576)
THREADS=4
PORT=8000                                            # open http://<pi-address>:8000 in a browser
HOST=0.0.0.0                                         # 0.0.0.0 = reachable from the network, 127.0.0.1 = only on the Pi itself
WEB_DATA=/mnt/raspi-ssd/New/web_data                 # report database + vehicle photos
REC_DIR=/mnt/raspi-ssd/New/recordings                # videos saved from the Recordings page
LOG=/mnt/raspi-ssd/New/service/web.log               # log file (kept on the SSD, rotated at 5 MB)
