# Settings for the web service (read every time the service starts).
# After editing:  sudo systemctl restart new-optimized-web
MODEL=/mnt/raspi-ssd/New/yolo_128_int8_xnnpack.pte   # model file (the 128 x 128 INT8 model)
IMGSZ=128                                            # must match the model: 128 for the 128 model, 256 for the 256 model
STREAM=sub                                           # sub = the camera's sub stream (light, keeps the Pi cooler), main = main stream (1080p, much more CPU / heat)
THREADS=4
REFINE_MODEL=/mnt/raspi-ssd/New/yolo_256_int8_xnnpack.pte   # second look with the 256 model for counted vehicles the live model is unsure about (confidence < 0.6; not two-wheelers); remove the line to switch off
#TRACK_LOG=1                                         # write service/out/tracks.csv: why every vehicle was / was not counted (for debugging)
PORT=8000                                            # open http://<pi-address>:8000 in a browser
HOST=0.0.0.0                                         # 0.0.0.0 = reachable from the network, 127.0.0.1 = only on the Pi itself
WEB_DATA=/mnt/raspi-ssd/New/web_data                 # report database + vehicle photos
REC_DIR=/mnt/raspi-ssd/New/recordings                # videos saved from the Recordings page
LOG=/mnt/raspi-ssd/New/service/web.log               # log file (kept on the SSD, rotated at 5 MB)
AUTO_RECORD=1                                        # 1 = record the live video automatically, one mp4 per hour, each with its own Excel report (counts by class); 0 = off
RECORD_KEEP_HOURS=72                                 # automatic hourly videos older than this are deleted (their Excel reports are kept for ever); 0 = never delete
RECORD_MIN_FREE_GB=8                                 # never let the disk fall below this: oldest hourly videos are deleted first, and recording pauses if still too full
